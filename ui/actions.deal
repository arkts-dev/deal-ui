export class Route {
  actionId: number;
  updateId: number;
  effectId: number;
  completionActionId: number;
}

export function noRoute(): Route {
  return {actionId: -1, updateId: -1, effectId: -1, completionActionId: -1};
}

export function route(actionId: number, updateId: number, effectId: number, completionActionId: number): Route {
  return {
    actionId: actionId,
    updateId: updateId,
    effectId: effectId,
    completionActionId: completionActionId
  };
}

export function hasEffect(value: Route): boolean {
  return value.effectId >= 0;
}
