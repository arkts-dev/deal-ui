export class Key {
  kind: string;
  numberValue: number;
  stringValue: string;
}

export class Prop {
  name: string;
  kind: string;
  stringValue: string;
  numberValue: number;
  booleanValue: boolean;
  actionSlot: number;
  actionBindings: table;
}

export class ViewNode {
  component: string;
  structural: string;
  keyKind: string;
  keyNumber: number;
  keyString: string;
  props: Prop[] ;
  children: ViewNode[] ;
}

export function noKey(): Key { return {kind: "none", numberValue: 0, stringValue: ""}; }
export function numberKey(value: number): Key { return {kind: "number", numberValue: value, stringValue: ""}; }
export function stringKey(value: string): Key { return { kind: "string", numberValue: 0, stringValue: value }; }
export function stringProp(name: string, value: string): Prop { return { name: name, kind: "string", stringValue: value ,numberValue: 0.0, booleanValue: false, actionSlot: -1, actionBindings: {}}; }
export function numberProp(name: string, value: number): Prop { return { name: name, kind: "number", numberValue: value ,stringValue: "", booleanValue: false, actionSlot: -1, actionBindings: {}}; }
export function booleanProp(name: string, value: boolean): Prop { return { name: name, kind: "boolean", booleanValue: value ,stringValue: "", numberValue: 0.0, actionSlot: -1, actionBindings: {}}; }
export function tokenProp(name: string, value: string): Prop { return { name: name, kind: "token", stringValue: value ,numberValue: 0.0, booleanValue: false, actionSlot: -1, actionBindings: {}}; }
export function actionProp(name: string, slot: number): Prop { return { name: name, kind: "action", actionSlot: slot ,stringValue: "", numberValue: 0.0, booleanValue: false, actionBindings: {}}; }
export function boundActionProp(name: string, slot: number, bindings: table): Prop { return { name: name, kind: "action", actionSlot: slot, actionBindings: bindings ,stringValue: "", numberValue: 0.0, booleanValue: false}; }

export function node(component: string, structural: string, key: Key, props: Prop[], children: ViewNode[]): ViewNode {
  return {
    component: component,
    structural: structural,
    keyKind: key.kind,
    keyNumber: key.numberValue,
    keyString: key.stringValue,
    props: props,
    children: children
  };
}
