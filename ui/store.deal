export class StoreLifecycle {
  disposed: boolean = false;
  draining: boolean = false;
  revision: int = 0;
}

export class QueueDecision {
  accepted: boolean = false;
  startDrain: boolean = false;
}

export function enqueueDecision(current: StoreLifecycle): QueueDecision {
  if (current.disposed) {
    return {};
  }
  return { accepted: true, startDrain: !current.draining };
}

export function beginDrain(current: StoreLifecycle): StoreLifecycle {
  return {
    disposed: current.disposed,
    draining: true,
    revision: current.revision
  };
}

export function commit(current: StoreLifecycle): StoreLifecycle {
  return {
    disposed: current.disposed,
    draining: true,
    revision: current.revision + 1
  };
}

export function reject(current: StoreLifecycle): StoreLifecycle {
  return {
    disposed: current.disposed,
    draining: true,
    revision: current.revision
  };
}

export function finish(current: StoreLifecycle): StoreLifecycle {
  return {
    disposed: current.disposed,
    draining: false,
    revision: current.revision
  };
}

export function dispose(current: StoreLifecycle): StoreLifecycle {
  return {
    disposed: true,
    draining: false,
    revision: current.revision
  };
}

export function acceptsCompletion(current: StoreLifecycle): boolean {
  return !current.disposed;
}
