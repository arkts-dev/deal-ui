import * as core from "./core";

export class Patch {
  kind: string;
  structural: string;
  keyKind: string;
  keyNumber: number;
  keyString: string;
  parentStructural: string;
  parentKeyKind: string;
  parentKeyNumber: number;
  parentKeyString: string;
  rootParent: boolean;
  index: number;
  node: core.ViewNode;
}

export class Plan { patches: Patch[] ; }

export function identityEquals(left: core.ViewNode, right: core.ViewNode): boolean {
  if (left.structural !== right.structural || left.keyKind !== right.keyKind) {
    return false;
  }
  if (left.keyKind === "number") {
    return left.keyNumber === right.keyNumber;
  }
  if (left.keyKind === "string") {
    return left.keyString === right.keyString;
  }
  return true;
}

function append(patches: Patch[], kind: string, node: core.ViewNode, parent: core.ViewNode, rootParent: boolean, index: number): null {
  patches[patches.length] = {
    kind: kind,
    structural: node.structural,
    keyKind: node.keyKind,
    keyNumber: node.keyNumber,
    keyString: node.keyString,
    parentStructural: parent.structural,
    parentKeyKind: parent.keyKind,
    parentKeyNumber: parent.keyNumber,
    parentKeyString: parent.keyString,
    rootParent: rootParent,
    index: index,
    node: node
  };
  return null;
}

function validateUnique(nodes: core.ViewNode[]): null {
  let leftIndex: number = 0;
  for (let left: core.ViewNode of nodes) {
    let rightIndex: number = 0;
    for (let right: core.ViewNode of nodes) {
      if (leftIndex < rightIndex && identityEquals(left, right)) {
        throw { code: "UI3003", message: "Duplicate sibling identity" };
      }
      rightIndex = rightIndex + 1;
    }
    validateUnique(left.children);
    leftIndex = leftIndex + 1;
  }
  return null;
}

function reconcileChildren(previous: core.ViewNode[], next: core.ViewNode[], parent: core.ViewNode, patches: Patch[]): null {
  validateUnique(next);
  for (let old: core.ViewNode of previous) {
    let retained: boolean = false;
    for (let node: core.ViewNode of next) {
      if (identityEquals(node, old) && node.component === old.component) {
        retained = true;
      }
    }
    if (!retained) {
      append(patches, "dispose", old, parent, false, 0);
    }
  }
  let index: number = 0;
  for (let node: core.ViewNode of next) {
    let retained: boolean = false;
    for (let old: core.ViewNode of previous) {
      if (identityEquals(old, node) && old.component === node.component) {
        retained = true;
        append(patches, "update", node, parent, false, index);
        reconcileChildren(old.children, node.children, node, patches);
      }
    }
    if (!retained) {
      append(patches, "create", node, parent, false, index);
    }
    index = index + 1;
  }
  return null;
}

export function plan(previous: core.ViewNode | null, next: core.ViewNode): Plan {
  validateUnique(next.children);
  let patches: Patch[] = [];
  let root: core.ViewNode = core.node("", "", core.noKey(), [], []);
  if (previous === null) {
    append(patches, "create", next, root, true, 0);
    return { patches: patches };
  }
  let old: core.ViewNode = next;
  if (previous !== null) {
    old = previous;
  }
  if (!identityEquals(old, next) || old.component !== next.component) {
    append(patches, "dispose", old, root, true, 0);
    append(patches, "create", next, root, true, 0);
    return { patches: patches };
  }
  append(patches, "update", next, root, true, 0);
  reconcileChildren(old.children, next.children, next, patches);
  return { patches: patches };
}
