export class EffectDescriptor {
  effectId: number;
  actionSlot: number;
  committedRevision: number;
}

export class EffectCommand {
  operation: string;
  key: string;
  delayMillis: number;
  cancellationMode: string;
}

export class CompletionDescriptor {
  accepted: boolean;
  actionSlot: number;
}

export function none(): EffectDescriptor {
  return {effectId: -1, actionSlot: -1, committedRevision: 0};
}

export function start(effectId: number, actionSlot: number, committedRevision: number): EffectDescriptor {
  return {
    effectId: effectId,
    actionSlot: actionSlot,
    committedRevision: committedRevision
  };
}

export function noCommand(): EffectCommand {
  return {operation: "none", key: "", delayMillis: 0, cancellationMode: "none"};
}

export function startCommand(key: string, delayMillis: number, cancellationMode: string): EffectCommand {
  return { operation: "start", key: key, delayMillis: delayMillis, cancellationMode: cancellationMode };
}

export function cancelCommand(key: string, cancellationMode: string): EffectCommand {
  return { operation: "cancel", key: key, cancellationMode: cancellationMode ,delayMillis: 0};
}

export function completion(disposed: boolean, actionSlot: number): CompletionDescriptor {
  return { accepted: !disposed, actionSlot: actionSlot };
}
