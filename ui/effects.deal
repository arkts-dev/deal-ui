export class EffectDescriptor {
  effectId: int = -1;
  actionSlot: int = -1;
  committedRevision: int = 0;
}

export class EffectCommand {
  operation: string = "none";
  key: string = "";
  delayMillis: int = 0;
  cancellationMode: string = "none";
}

export class CompletionDescriptor {
  accepted: boolean = false;
  actionSlot: int = -1;
}

export function none(): EffectDescriptor {
  return {};
}

export function start(effectId: int, actionSlot: int, committedRevision: int): EffectDescriptor {
  return {
    effectId: effectId,
    actionSlot: actionSlot,
    committedRevision: committedRevision
  };
}

export function noCommand(): EffectCommand {
  return {};
}

export function startCommand(key: string, delayMillis: int, cancellationMode: string): EffectCommand {
  return { operation: "start", key: key, delayMillis: delayMillis, cancellationMode: cancellationMode };
}

export function cancelCommand(key: string, cancellationMode: string): EffectCommand {
  return { operation: "cancel", key: key, cancellationMode: cancellationMode };
}

export function completion(disposed: boolean, actionSlot: int): CompletionDescriptor {
  return { accepted: !disposed, actionSlot: actionSlot };
}
