import * as json from "std/json";

// Transport ingress uses DEAL JSON-number grammar, not host-language coercion.
export function payloadNumber(text: string): number {
    let object: Record<string, unknown> = json.parse("{\"value\":"+text+"}");
    let value: number = object.value as number;
    if (value-value !== 0) { throw {code:"UI3007",message:"Expected finite JSON number"}; }
    return value;
}

// Runtime-owned observation/accounting for one mounted root. Application state and
// store/queue decisions remain in the generated typed entry and store module.
// Driver time is sampled by the host; visibility and resume deltas are policy.
export class FrameClock { visible: boolean; previous: number; delta: number; }
export function frameVisibility(visible: boolean): FrameClock { return {visible:visible,previous:-1,delta:-1}; }
export function frameSample(current: FrameClock, now: number): FrameClock {
    if (now-now !== 0 || now < 0) { throw {code:"UI3006",message:"Invalid frame time"}; }
    if (!current.visible) { return current; }
    let delta: number = 0;
    if (current.previous >= 0 && now >= current.previous) { delta = now-current.previous; }
    return {visible:true,previous:now,delta:delta};
}
export class SessionStatus {
    inFlight: number;
    version: number;
    fault: string;
}
export function sessionCommitted(current: SessionStatus): SessionStatus {
    return { inFlight: current.inFlight, version: current.version + 1, fault: current.fault };
}
export function sessionStarted(current: SessionStatus): SessionStatus {
    return { inFlight: current.inFlight + 1, version: current.version, fault: current.fault };
}
export function sessionExited(current: SessionStatus): SessionStatus {
    if (current.inFlight < 1) { throw { code: "UI3005", message: "Effect accounting underflow" }; }
    return { inFlight: current.inFlight - 1, version: current.version, fault: current.fault };
}
export function sessionFailed(current: SessionStatus, message: string, effect: boolean): SessionStatus {
    let version: number = current.version;
    if (effect) { version = version + 1; }
    return { inFlight: current.inFlight, version: version, fault: message };
}
export function sessionReplacementReady(current: SessionStatus): boolean { return current.inFlight === 0; }
