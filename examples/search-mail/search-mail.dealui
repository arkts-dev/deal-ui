import * as app from "./search-mail";
import * as ui from "./platform-ui.dealui-pack";
// @ui-root
export view SearchMail(state: app.SearchState): View {
  ui.Card() { ui.Column(spacing: ui.spaceMd) {
    ui.Text(value: "SEARCH MAIL")
    ui.Input(value: state.query, accessibilityLabel: "Search messages", onSubmit: action app.Search { query: payload })
    ui.Text(value: state.status)
    When(state.status === "debouncing") {
      ui.Text(value: "Waiting to search")
      ui.Spinner()
      ui.Button(text: "Cancel", accessibilityLabel: "Cancel search", onClick: action app.Cancel {})
    } Else {
      When(state.status === "loading") {
        ui.Text(value: "Searching mailbox")
        ui.Spinner()
        ui.Button(text: "Cancel", accessibilityLabel: "Cancel search", onClick: action app.Cancel {})
      } Else {
        When(state.status === "error") {
          ui.Text(value: state.errorMessage)
          ui.Button(text: "Retry", accessibilityLabel: "Retry search", onClick: action app.Retry {})
        } Else {
          ui.Text(value: state.result)
          ForEach(state.matches, message: app.MailRecord, key: message.id) {
            ui.Card() { ui.Column(spacing: ui.spaceMd) {
              ui.Text(value: message.subject)
              ui.Text(value: message.sender)
              ui.Text(value: message.body)
            } }
          }
          ui.Button(text: "Cancel", accessibilityLabel: "Cancel search", onClick: action app.Cancel {})
        }
      }
    }
  } }
}
