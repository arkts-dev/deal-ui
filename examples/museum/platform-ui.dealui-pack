export class Space {
  value: int = 0;
}

export class TextProps {
  value: string = "";
}

export class IntTextProps {
  value: int = 0;
}

export class InputProps {
  value: string = "";
  onSubmit?: Action;
  accessibilityLabel?: string;
}

export class ButtonProps {
  text: string = "";
  onClick?: Action;
  accessibilityLabel?: string;
}

export class ColumnProps {
  spacing?: Space;
}

export class EmptyProps {}

export component Text(props: TextProps): View {
  capability "renderer.swing.TEXT";
}
export component IntText(props: IntTextProps): View {
  capability "renderer.swing.INT_TEXT";
}
export component Spinner(props: EmptyProps): View {
  capability "renderer.swing.SPINNER";
}
export component Input(props: InputProps): View {
  event onSubmit(payload: string);
  accessibility accessibilityLabel;
  capability "renderer.swing.INPUT";
}
export component Card(props: EmptyProps): View {
  children optional;
  capability "renderer.swing.CARD";
}
export component Button(props: ButtonProps): View {
  event onClick;
  accessibility accessibilityLabel;
  capability "renderer.swing.BUTTON";
}
export component Column(props: ColumnProps): View {
  children optional;
  token spacing;
  capability "renderer.swing.COLUMN";
}

export token spaceMd: Space = { value: 14 };
