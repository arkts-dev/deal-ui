import * as app from "./dashboard";
import * as ui from "./platform-ui.dealui-pack";
// @ui-root
export view Dashboard(state: app.DashboardState): View {
  ui.Root(spacing: ui.spaceMd, focusIntent: state.focusIntent, focusRevision: state.focusRevision) {
    ui.Card() { ui.Column(spacing: ui.spaceMd) {
      ui.Text(value: "OPERATIONS DASHBOARD")
      ui.Text(value: state.announcement)
      ui.Text(value: state.command)
      ui.Button(text: "Open settings", accessibilityLabel: "Open settings dialog", focusId: "open-settings", onClick: action app.OpenModal {})
      When(!state.overlayOpen) { ui.Text(value: "No overlay open") }
    } }
    When(state.overlayOpen) {
      ui.Modal(spacing: ui.spaceMd, accessibilityLabel: "Settings", accessibilityDescription: "Dashboard settings dialog", scopeRevision: state.scopeRevision, scopeInterval: 1000, onScopeTick: action app.SubscriptionTick { scope: payload }, onEscape: action app.EscapeCommand {}) {
        ui.Text(value: "SETTINGS DIALOG", focusId: "settings-name")
        ui.Text(value: "Subscription scope active")
        ui.Button(text: "Close settings", accessibilityLabel: "Close settings and restore focus", onClick: action app.CloseModal {})
      }
    }
  }
}
