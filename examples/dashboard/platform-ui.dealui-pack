export class Space { value: int = 0; }
export class TextProps { value: string = ""; focusId?: string; }
export class ButtonProps { text: string = ""; onClick?: Action; accessibilityLabel?: string; focusId?: string; }
export class ColumnProps { spacing?: Space; }
export class RootProps { spacing?: Space; focusIntent: string = ""; focusRevision: int = 0; }
export class ModalProps { spacing?: Space; accessibilityLabel: string = ""; accessibilityDescription: string = ""; focusId?: string; scopeRevision: int = 0; scopeInterval: int = 1000; onScopeTick?: Action; onEscape?: Action; }
export class EmptyProps {}
export component Text(props: TextProps): View { capability "renderer.swing.text"; }
export component Button(props: ButtonProps): View { event onClick; accessibility accessibilityLabel; capability "renderer.swing.button"; }
export component Column(props: ColumnProps): View { children optional; token spacing; capability "renderer.swing.column"; }
export component Root(props: RootProps): View { children optional; token spacing; capability "renderer.swing.column"; }
export component Card(props: EmptyProps): View { children optional; capability "renderer.swing.card"; }
export component Modal(props: ModalProps): View { children optional; event onScopeTick(payload: int); event onEscape; accessibility accessibilityLabel; token spacing; capability "renderer.swing.modal"; }
export token spaceMd: Space = { value: 14 };
