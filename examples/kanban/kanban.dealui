import * as app from "./kanban";
import * as ui from "./platform-ui.dealui-pack";

// @ui-root
export view Kanban(state: app.BoardState): View {
  ui.Card() {
    ui.Column(spacing: ui.spaceMd) {
      ui.Text(value: "KANBAN / VIRTUAL GRID")
      ui.Text(value: state.focusIntent)
      ui.IntText(value: state.selectedId)
      ui.Text(value: "Visible cards")
      ForEach(state.visibleCards, card: app.Card, key: card.id) {
        ui.Card() {
          ui.Column(spacing: ui.spaceMd) {
            ui.Text(value: card.title)
            ui.Text(value: card.column)
          }
        }
      }
      ui.Button(text: "Select first", accessibilityLabel: "Select first card", onClick: action app.Select { id: 1 })
      ui.Button(text: "Move first to doing", accessibilityLabel: "Move first card to doing", onClick: action app.Move { id: 1, destination: "doing" })
      ui.Button(text: "Try denied archive move", accessibilityLabel: "Try denied archive move", onClick: action app.Move { id: 1, destination: "archive" })
      ui.Button(text: "Previous page", accessibilityLabel: "Previous page", onClick: action app.PreviousPage {})
      ui.Button(text: "Next page", accessibilityLabel: "Next page", onClick: action app.NextPage {})
      ui.Text(value: state.message)
    }
  }
}
