import * as interaction from "../../ui/interaction";

export class Card { id: number; title: string; column: string; focusId: string; todoFocusId: string; doingFocusId: string; doneFocusId: string; archiveFocusId: string; }
class WindowPolicy { offset: number; limit: number; total: number; }
class OptimisticPolicy { revision: number; pendingRevision: number; rollbackRevision: number; }
export class BoardState {
  cards: Card[] ;
  priorCards: Card[] ;
  visibleCards: Card[] ;
  selectedId: number;
  focusIntent: string;
  focusRevision: number;
  pageOffset: number;
  pageLimit: number;
  total: number;
  revision: number;
  pendingRevision: number;
  rollbackRevision: number;
  message: string;
}
export class Select { id: number; }
export class Move { id: number; destination: string; }
export class NextPage {}
export class PreviousPage {}
export class MoveCompleted { revision: number; accepted: boolean; message: string; }
export class EffectCommand { operation: string; key: string; delayMillis: number; cancellationMode: string; }

function copyCards(cards: Card[]): Card[] {
  let result: Card[] = [];
  for (let card: Card of cards) { result[result.length] = { id: card.id, title: card.title, column: card.column, focusId: card.focusId, todoFocusId: card.todoFocusId, doingFocusId: card.doingFocusId, doneFocusId: card.doneFocusId, archiveFocusId: card.archiveFocusId }; }
  return result;
}

function moveCard(cards: Card[], id: number, destination: string): Card[] {
  let result: Card[] = [];
  for (let card: Card of cards) {
    if (card.id === id) { result[result.length] = { id: card.id, title: card.title, column: destination, focusId: card.focusId, todoFocusId: card.todoFocusId, doingFocusId: card.doingFocusId, doneFocusId: card.doneFocusId, archiveFocusId: card.archiveFocusId }; }
    else { result[result.length] = { id: card.id, title: card.title, column: card.column, focusId: card.focusId, todoFocusId: card.todoFocusId, doingFocusId: card.doingFocusId, doneFocusId: card.doneFocusId, archiveFocusId: card.archiveFocusId }; }
  }
  return result;
}

function hasCard(cards: Card[], id: number): boolean {
  for (let card: Card of cards) { if (card.id === id) { return true; } }
  return false;
}

function destinationValid(destination: string): boolean { return destination === "todo" || destination === "doing" || destination === "done"; }

function clampWindow(offset: number, limit: number, total: number): WindowPolicy {
  let safeLimit: number = limit;
  if (safeLimit < 1) { safeLimit = 1; }
  let maximum: number = total - safeLimit;
  if (maximum < 0) { maximum = 0; }
  let safeOffset: number = offset;
  if (safeOffset < 0) { safeOffset = 0; }
  if (safeOffset > maximum) { safeOffset = maximum; }
  return { offset: safeOffset, limit: safeLimit, total: total };
}

function beginOptimistic(revision: number): OptimisticPolicy {
  let next: number = revision + 1;
  return { revision: next, pendingRevision: next, rollbackRevision: revision };
}

function finishOptimistic(current: OptimisticPolicy, revision: number): OptimisticPolicy {
  if (!interaction.completionActive(current.pendingRevision, revision, current.pendingRevision !== 0)) { return current; }
  return { revision: current.revision ,pendingRevision: 0, rollbackRevision: 0};
}

function visibleWindow(cards: Card[], window: WindowPolicy): Card[] {
  let result: Card[] = [];
  let index: number = 0;
  for (let card: Card of cards) {
    if (index >= window.offset && index < window.offset + window.limit) { result[result.length] = card; }
    index = index + 1;
  }
  return result;
}

function cardFocus(cards: Card[], id: number): string {
  for (let card: Card of cards) { if (card.id === id) { return card.focusId; } }
  return "";
}

function destinationFocus(cards: Card[], id: number, destination: string): string {
  for (let card: Card of cards) {
    if (card.id === id) {
      if (destination === "todo") { return card.todoFocusId; }
      if (destination === "doing") { return card.doingFocusId; }
      if (destination === "done") { return card.doneFocusId; }
      return card.archiveFocusId;
    }
  }
  return "";
}

function windowFocus(cards: Card[], window: WindowPolicy): string {
  let visible: Card[] = visibleWindow(cards, window);
  for (let card: Card of visible) { return card.focusId; }
  return "previous-page";
}

function stateWithWindow(cards: Card[], priorCards: Card[], window: WindowPolicy, revision: number, pendingRevision: number, rollbackRevision: number, selectedId: number, focusIntent: string, focusRevision: number, message: string): BoardState {
  return { cards: cards, priorCards: priorCards, visibleCards: visibleWindow(cards, window), selectedId: selectedId, focusIntent: focusIntent, focusRevision: focusRevision + 1, pageOffset: window.offset, pageLimit: window.limit, total: window.total, revision: revision, pendingRevision: pendingRevision, rollbackRevision: rollbackRevision, message: message };
}

export function initialState(): BoardState {
  let first: Card = { id: 1, title: "Ship portable policy", column: "todo", focusId: "card-1", todoFocusId: "card-1-todo", doingFocusId: "card-1-doing", doneFocusId: "card-1-done", archiveFocusId: "card-1-archive" };
  let second: Card = { id: 2, title: "Review renderer", column: "doing", focusId: "card-2", todoFocusId: "card-2-todo", doingFocusId: "card-2-doing", doneFocusId: "card-2-done", archiveFocusId: "card-2-archive" };
  let third: Card = { id: 3, title: "Verify rollback", column: "todo", focusId: "card-3", todoFocusId: "card-3-todo", doingFocusId: "card-3-doing", doneFocusId: "card-3-done", archiveFocusId: "card-3-archive" };
  let fourth: Card = { id: 4, title: "Publish completion", column: "done", focusId: "card-4", todoFocusId: "card-4-todo", doingFocusId: "card-4-doing", doneFocusId: "card-4-done", archiveFocusId: "card-4-archive" };
  let cards: Card[] = [first, second, third, fourth];
  let window: WindowPolicy = clampWindow(0, 2, cards.length);
  return { cards: cards, visibleCards: visibleWindow(cards, window), focusIntent: first.focusId, pageOffset: window.offset, pageLimit: window.limit, total: window.total ,priorCards: [], selectedId: 0, focusRevision: 0, revision: 0, pendingRevision: 0, rollbackRevision: 0, message: "Choose a valid or denied move"};
}

// @ui-update
export function select(state: BoardState, action: Select): BoardState {
  if (!hasCard(state.cards, action.id)) { return state; }
  let window: WindowPolicy = clampWindow(state.pageOffset, state.pageLimit, state.cards.length);
  return stateWithWindow(state.cards, state.priorCards, window, state.revision, state.pendingRevision, state.rollbackRevision, action.id, cardFocus(state.cards, action.id), state.focusRevision, state.message);
}

// @ui-update
export function move(state: BoardState, action: Move): BoardState {
  if (state.pendingRevision !== 0) {
    let busyWindow: WindowPolicy = clampWindow(state.pageOffset, state.pageLimit, state.cards.length);
    return stateWithWindow(state.cards, state.priorCards, busyWindow, state.revision, state.pendingRevision, state.rollbackRevision, state.selectedId, state.focusIntent, state.focusRevision, "Wait for the pending move to complete");
  }
  if (!hasCard(state.cards, action.id)) {
    let missingWindow: WindowPolicy = clampWindow(state.pageOffset, state.pageLimit, state.cards.length);
    return stateWithWindow(state.cards, state.priorCards, missingWindow, state.revision, state.pendingRevision, state.rollbackRevision, state.selectedId, windowFocus(state.cards, missingWindow), state.focusRevision, "Card no longer exists");
  }
  let policy: OptimisticPolicy = beginOptimistic(state.revision);
  let cards: Card[] = moveCard(state.cards, action.id, action.destination);
  let window: WindowPolicy = clampWindow(state.pageOffset, state.pageLimit, cards.length);
  return stateWithWindow(cards, copyCards(state.cards), window, policy.revision, policy.pendingRevision, policy.rollbackRevision, action.id, destinationFocus(cards, action.id, action.destination), state.focusRevision, "Validating move");
}

// @ui-effect-policy
export function movePolicy(state: BoardState, action: Move): EffectCommand { return {operation: "start", key: "kanban-move", delayMillis: 180, cancellationMode: "replace"}; }

// @ui-effect
export async function validateMove(state: BoardState, action: Move): MoveCompleted {
  if (!hasCard(state.priorCards, action.id)) { return { revision: state.pendingRevision, message: "Card no longer exists" ,accepted: false}; }
  if (!destinationValid(action.destination)) { return { revision: state.pendingRevision, message: "Destination 'archive' is not part of this board" ,accepted: false}; }
  return { revision: state.pendingRevision, accepted: true, message: "Move accepted" };
}

// @ui-effect-failure
export function moveFailure(state: BoardState, action: Move, message: string): MoveCompleted {
  return { revision: state.pendingRevision, message: "Move validation failed: " + message ,accepted: false};
}

// @ui-update
export function completeMove(state: BoardState, action: MoveCompleted): BoardState {
  if (!interaction.completionActive(state.pendingRevision, action.revision, state.pendingRevision !== 0)) { return state; }
  let current: OptimisticPolicy = { revision: state.revision, pendingRevision: state.pendingRevision, rollbackRevision: state.rollbackRevision };
  let policy: OptimisticPolicy = finishOptimistic(current, action.revision);
  if (action.accepted) {
    let committedWindow: WindowPolicy = clampWindow(state.pageOffset, state.pageLimit, state.cards.length);
    return stateWithWindow(state.cards, [], committedWindow, policy.revision, policy.pendingRevision, policy.rollbackRevision, state.selectedId, cardFocus(state.cards, state.selectedId), state.focusRevision, action.message);
  }
  let cards: Card[] = copyCards(state.priorCards);
  let rollbackWindow: WindowPolicy = clampWindow(state.pageOffset, state.pageLimit, cards.length);
  return stateWithWindow(cards, [], rollbackWindow, state.rollbackRevision, policy.pendingRevision, state.rollbackRevision, state.selectedId, cardFocus(cards, state.selectedId), state.focusRevision, action.message);
}

// @ui-update
export function nextPage(state: BoardState, action: NextPage): BoardState {
  let window: WindowPolicy = clampWindow(state.pageOffset + state.pageLimit, state.pageLimit, state.cards.length);
  return stateWithWindow(state.cards, state.priorCards, window, state.revision, state.pendingRevision, state.rollbackRevision, state.selectedId, windowFocus(state.cards, window), state.focusRevision, state.message);
}

// @ui-update
export function previousPage(state: BoardState, action: PreviousPage): BoardState {
  let window: WindowPolicy = clampWindow(state.pageOffset - state.pageLimit, state.pageLimit, state.cards.length);
  return stateWithWindow(state.cards, state.priorCards, window, state.revision, state.pendingRevision, state.rollbackRevision, state.selectedId, windowFocus(state.cards, window), state.focusRevision, state.message);
}

export function main(): null { return null; }
