import * as app from "./checkout";
import * as ui from "./platform-ui.dealui-pack";

// @ui-root
export view Checkout(state: app.CheckoutState): View {
  ui.Card() {
    ui.Column(spacing: ui.spaceMd) {
      ui.Text(value: "CHECKOUT / CONTACT / PAYMENT")
      ui.Text(value: state.route)
      ui.Input(value: state.email, accessibilityLabel: "Email address", onSubmit: action app.EditEmail { value: payload })
      When(state.touched && !state.valid) { ui.Text(value: state.guardMessage) } Else { ui.Text(value: "Contact information is ready") }
      ui.Button(text: "Review email", accessibilityLabel: "Review email validation", onClick: action app.TouchEmail {})
      ui.Button(text: "Continue to payment", accessibilityLabel: "Continue to payment", onClick: action app.Continue {})
      ui.Button(text: "Return to contact", accessibilityLabel: "Return to contact", onClick: action app.ReturnToContact {})
    }
  }
}
