#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export DEAL_FS_ROOT="${DEAL_FS_ROOT:-$ROOT/../deal}"
"$ROOT/scripts/compile.sh"
JAVA=java
if [[ "${1:-}" == "run" ]]; then
  JAVA=$("$ROOT/scripts/java-ui.sh")
fi
exec "$JAVA" -Ddeal.ui.frameworkRoot="$ROOT" -cp "$ROOT/build/classes:$DEAL_FS_ROOT/build" deal.ui.Main "$@"
