import * as work from "host/work";
import * as callbacks from "./callbacks";
export class Row { values: number[]; }
export class State { value: number; rows: Row[]; }
export class Start { value: number; }
export class Done { value: number; }
export class Bad {}
export function initialState(): State { return {value: callbacks.verify(), rows: [{values: [1, 2]}]}; }
// @ui-update
export function start(state: State, action: Start): State { return state; }
// @ui-effect
export async function run(state: State, action: Start): Promise<Done> {
    let value: number = await work.run(action.value);
    return { value: value };
}
// @ui-update
export function done(state: State, action: Done): State { return { value: state.value * 10 + action.value, rows: state.rows }; }
// @ui-update
export function bad(state: State, action: Bad): State { throw { code: "UPDATE_FAILED", message: "Injected update failure" }; }
export function main(): null { return null; }
